# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Local environment / secrets
.env
.env.*
!.env.example

# Runtime data and generated state (non-public)
data/
AutoBackUp/
mock/
releases/
private/
exports/
downloads/

# SQLite runtime files
*.db
*.db-journal
*.db-wal
*.db-shm
