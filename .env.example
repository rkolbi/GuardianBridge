LATITUDE=30.0000
LONGITUDE=-90.0000
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-password
IMAP_SERVER=imap.example.com
IMAP_PORT=993
TRASH_FOLDER_NAME=Trash
MAX_EMAIL_BODY_LEN=180
MESHTASTIC_PORT=None
LOG_LEVEL=INFO
WEATHER_ALERT_INTERVAL_MINS=30
WEATHER_UPDATE_INTERVAL_MINS=60
COMMAND_COOLDOWN_SECONDS=1.0
MIN_SEND_INTERVAL_SECONDS=0.6
COMMAND_JOB_POLL_SECONDS=0.5
COMMAND_QUEUE_WAIT_WARN_MS=1500
COMMAND_HANDLER_WARN_MS=2500
SEND_QUEUE_WAIT_WARN_MS=3000
SEND_EXEC_WARN_MS=2000
FORECAST_MORNING_SEND_TIME=06:05
FORECAST_AFTERNOON_SEND_TIME=18:05

# --- SOS NOTIFICATION SETTINGS ---
# Enable/disable email notifications for each SOS type. Set to True or False.
SOS_EMAIL_ENABLED=True
SOSM_EMAIL_ENABLED=False
SOSF_EMAIL_ENABLED=False
SOSP_EMAIL_ENABLED=True

# Comma-separated list of email addresses to receive notifications.
SOS_EMAIL_RECIPIENTS=
SOSM_EMAIL_RECIPIENTS=
SOSF_EMAIL_RECIPIENTS=
SOSP_EMAIL_RECIPIENTS=

# --- SOS TIMERS & ESCALATION (in minutes) ---
# Time to wait for a tagged responder to acknowledge an SOS before broadcast.
SOS_ACK_TIMEOUT_MINS=5
# How often to send a check-in ping to a user in an active SOS state.
SOS_CHECKIN_INTERVAL_MINS=5
# How many unanswered check-ins before marking a user as unresponsive.
SOS_CHECKIN_MAX_ATTEMPTS=3
